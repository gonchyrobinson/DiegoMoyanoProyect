@using DiegoMoyanoProject.ViewModels.UserPdf;
@model DiegoMoyanoProject.ViewModels.UserPdf.IndexDateUserPdfViewModel;
@if (Model.Pdf != null)
{
    <div class="container text-center">
        <h1 class="display-4" id="UserPdfTitleMessageNotO">Reporte de datos del @Model.SelectedDate</h1>
    </div>

    <div class="gallery container row" onclick="openLightbox(event)">
        <div class="container text-center col-lg-4 col-md-6 col-sm-12">
                <h5 class="text-primary font-weight-bold">Descargar reportes</h5>
                <form asp-controller="UserPdf" asp-action="OnGetDownloadFileFromFolder" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="pdf" value="@Convert.ToBase64String(Model.Pdf)" />
                    <button type="submit" class="btn btn-primary">
                        <img src="~/img/UserPdf/no_pdf.jpg" />
                        <p>Descargar Reporte</p>
                    </button>
                </form>
        </div>
    </div>


}
else
{
    <section class="py-3 py-md-5 min-vh-100 d-flex justify-content-center align-items-center">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="text-center">
                        <h2 class="d-flex justify-content-center align-items-center gap-2 mb-4">
                            <span class="display-1 fw-bold">4</span>
                            <i class="bi bi-exclamation-circle-fill text-danger display-4"></i>
                            <span class="display-1 fw-bold bsb-flip-h">4</span>
                        </h2>
                        <h3 class="h2 mb-2">Oops! Aún no se cargó el reporte para esta fecha.</h3>
                        <p class="mb-5">Si quiere ver el reporte, por favor vuelva a ingresar mas tarde</p>
                        <a class="btn bsb-btn-5xl btn-dark rounded-pill px-5 fs-6 m-0" asp-controller="Home" asp-action="Index" role="button">Volver a inicio</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
@if (Model.Dates.Count() > 0)
{
    <div class="container text-center">
        <ul class="list-group list-unstyled d-flex flex-row flex-wrap justify-content-center">
            @foreach (var modelDate in Model.Dates)
            {
                var order = 1;
                var idForDate = "DatesUserData_" + order;
                <li class="border m-2 border-primary rounded">
                    <a asp-controller="UserPdf" asp-action="IndexDate" asp-route-date="@modelDate.Date.ToString("yyyy-MM-dd")" asp-route-id="@modelDate.Id" class="text-decoration-none list-group-item btn btn-outline-primary btn-lg px-5 py-3 fs-6 fw-bolder" id="@idForDate" data-info="@modelDate.Date.ToString("MMMM yyyy")">
                        @modelDate.Date.ToString("dd-MM-yyyy")
                    </a>
                </li>
            }
        </ul>
    </div>
}
@section Scripts {
    <script>
        window.onload = function () {
            const element = document.getElementById('UserPdfTitleMessageNotO');
            const title = 'Reportes de ';
            displayMessage(element, title, '@Model.SelectedDate');
        }
        document.addEventListener('DOMContentLoaded', function () {
            const links = document.querySelectorAll('a[data-info]');
            links.forEach(link => {
                const date = link.getAttribute('data-info');
                displaySelectedDateA(link, date)
            });
        });
    </script>
}


